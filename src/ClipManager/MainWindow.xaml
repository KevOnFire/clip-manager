<ui:FluentWindow
    x:Class="ClipManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Clippy"
    Icon="pack://application:,,,/Assets/clippy.ico"
    Width="1280"
    Height="800"
    MinWidth="900"
    MinHeight="560"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    PreviewKeyDown="Window_PreviewKeyDown"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Clippy">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/clippy.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Seitenleiste -->
            <DockPanel x:Name="Sidebar" Grid.Column="0" Margin="12,8,8,12">
                <TextBlock
                    x:Name="VersionText"
                    DockPanel.Dock="Bottom"
                    Margin="8,0,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <ui:Button
                    x:Name="UpdateButton"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Appearance="Success"
                    Click="UpdateButton_Click"
                    Content="Update verfügbar"
                    DockPanel.Dock="Bottom"
                    Icon="{ui:SymbolIcon ArrowDownload24}"
                    Visibility="Collapsed" />
                <StackPanel>
                    <ui:Button
                        x:Name="LibraryNav"
                        Margin="0,0,0,4"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="LibraryNav_Click"
                        Content="Bibliothek"
                        Icon="{ui:SymbolIcon VideoClip24}" />
                    <ui:Button
                        x:Name="SettingsNav"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="SettingsNav_Click"
                        Content="Einstellungen"
                        Icon="{ui:SymbolIcon Settings24}" />
                </StackPanel>
            </DockPanel>

            <ContentControl
                x:Name="PageHost"
                Grid.Column="1"
                Margin="8,8,24,16" />
        </Grid>
    </Grid>
</ui:FluentWindow>
