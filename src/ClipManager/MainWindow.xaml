<ui:FluentWindow
    x:Class="ClipManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Clippy"
    Icon="pack://application:,,,/Assets/clippy.ico"
    Width="1280"
    Height="800"
    MinWidth="900"
    MinHeight="560"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    PreviewKeyDown="Window_PreviewKeyDown"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Titelleiste: Icon und Name liegen selbst drüber, das eingebaute Icon wurde abgeschnitten -->
        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Height="42" />
        <StackPanel
            x:Name="TitleLogo"
            Grid.Row="0"
            Margin="12,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Orientation="Horizontal">
            <Image
                Width="28"
                Height="28"
                RenderOptions.BitmapScalingMode="HighQuality"
                Source="pack://application:,,,/Assets/clippy.png" />
            <TextBlock
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Clippy" />
        </StackPanel>

        <!-- Navigation: klein oben statt Seitenleiste, damit die Clips mehr Platz haben -->
        <DockPanel x:Name="NavBar" Grid.Row="1" Margin="16,0,16,6">
            <TextBlock
                x:Name="VersionText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                FontSize="11"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <ui:Button
                x:Name="UpdateButton"
                Padding="10,4"
                Appearance="Success"
                Click="UpdateButton_Click"
                Content="Update verfügbar"
                DockPanel.Dock="Right"
                FontSize="12"
                Icon="{ui:SymbolIcon ArrowDownload20}"
                Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal">
                <ui:Button
                    x:Name="LibraryNav"
                    Margin="0,0,6,0"
                    Padding="10,4"
                    Click="LibraryNav_Click"
                    Content="Bibliothek"
                    FontSize="13"
                    Icon="{ui:SymbolIcon VideoClip20}" />
                <ui:Button
                    x:Name="SettingsNav"
                    Padding="10,4"
                    Click="SettingsNav_Click"
                    Content="Einstellungen"
                    FontSize="13"
                    Icon="{ui:SymbolIcon Settings20}" />
            </StackPanel>
        </DockPanel>

        <ContentControl
            x:Name="PageHost"
            Grid.Row="2"
            Focusable="False"
            FocusVisualStyle="{x:Null}"
            IsTabStop="False"
            Margin="16,4,16,16" />
    </Grid>
</ui:FluentWindow>
