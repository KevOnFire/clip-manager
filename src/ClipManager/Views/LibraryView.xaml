<UserControl
    x:Class="ClipManager.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ClipManager.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:FavoriteBrushConverter x:Key="FavoriteBrush" />

        <ContextMenu x:Key="TileMenu" x:Shared="False">
            <MenuItem Click="MenuSelect_Click" Header="Auswählen (mehrere Clips)">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="CheckmarkCircle24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="MenuPlay_Click" Header="Abspielen">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Play24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem
                Click="MenuMarkSeen_Click"
                Header="Als angeschaut markieren"
                Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Checkmark24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuDisplayName_Click" Header="Namen im Programm ändern">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Tag24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuRename_Click" Header="Datei umbenennen">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Rename24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuCopy_Click" Header="Kopie erstellen">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuExplorer_Click" Header="Im Explorer zeigen">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="MenuDelete_Click" Header="Löschen (Papierkorb)">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:ClipTileViewModel}">
            <Grid
                Width="296"
                Margin="0,0,16,16"
                Background="Transparent"
                ContextMenu="{StaticResource TileMenu}"
                Cursor="Hand"
                MouseEnter="Tile_MouseEnter"
                MouseLeftButtonDown="Tile_MouseDown"
                MouseLeftButtonUp="Tile_Click">
            <Border
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <!-- Inhalt an den runden Ecken abschneiden, damit Vorschaubild und Rahmen genau passen -->
                <Grid local:RoundClip.Radius="7">
                <StackPanel>
                    <Grid
                        Height="165"
                        ClipToBounds="True"
                        MouseEnter="Thumb_MouseEnter"
                        MouseLeave="Thumb_MouseLeave">
                        <Border Background="#FF0E0E12" CornerRadius="7,7,0,0">
                            <ui:SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="36"
                                Foreground="#55FFFFFF"
                                Symbol="VideoClip24" />
                        </Border>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />

                        <!-- Dauer oben rechts -->
                        <Border
                            Margin="8"
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#CC000000"
                            CornerRadius="10"
                            Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding DurationText}" />
                        </Border>

                        <!-- Oben links: "NEU" (noch nicht angeschaut) und Schere (Schnitte gespeichert) -->
                        <StackPanel
                            Margin="8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">
                            <Border
                                Margin="0,0,6,0"
                                Padding="8,2"
                                Background="{DynamicResource AccentFillColorDefaultBrush}"
                                CornerRadius="10"
                                ToolTip="Neuer Clip, noch nicht angeschaut"
                                Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="NEU" />
                            </Border>
                            <Border
                                Padding="7,3"
                                Background="#CC000000"
                                CornerRadius="10"
                                ToolTip="Geschnitten (Original unverändert)"
                                Visibility="{Binding IsEdited, Converter={StaticResource BoolToVis}}">
                                <ui:SymbolIcon
                                    FontSize="14"
                                    Foreground="#FFFFC83D"
                                    Symbol="Cut24" />
                            </Border>
                        </StackPanel>

                        <!-- Auswahl unten links (nur im Auswahl-Modus) -->
                        <Border
                            Width="30"
                            Height="30"
                            Margin="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="#99000000"
                            CornerRadius="15"
                            IsHitTestVisible="False"
                            Visibility="{Binding ShowSelectCircle, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon FontSize="22" Foreground="White" Symbol="Circle24" />
                        </Border>
                        <Border
                            Width="30"
                            Height="30"
                            Margin="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="White"
                            CornerRadius="15"
                            IsHitTestVisible="False"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon
                                FontSize="30"
                                Filled="True"
                                Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                Symbol="CheckmarkCircle24" />
                        </Border>

                        <!-- Favorit unten rechts -->
                        <Button
                            Width="34"
                            Height="34"
                            Margin="8"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#99000000"
                            BorderThickness="0"
                            Click="Star_Click"
                            Cursor="Hand"
                            ToolTip="Favorit">
                            <ui:SymbolIcon
                                FontSize="18"
                                Filled="{Binding IsFavorite}"
                                Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteBrush}}"
                                Symbol="Star24" />
                        </Button>
                    </Grid>

                    <Grid Margin="12,10,4,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding ToolTipText}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding DateText}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding Details}" />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="1"
                            Padding="6"
                            VerticalAlignment="Top"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Click="MoreButton_Click"
                            Icon="{ui:SymbolIcon MoreVertical24}"
                            ToolTip="Mehr" />
                    </Grid>
                </StackPanel>
                </Grid>
            </Border>
            <!-- Neue Clips leuchten beim Anzeigen ein paar Sekunden lang auf -->
            <Grid IsHitTestVisible="False" Opacity="0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsNew}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                BeginTime="0:0:0.3"
                                                RepeatBehavior="3x"
                                                Storyboard.TargetProperty="Opacity"
                                                From="0"
                                                To="1"
                                                Duration="0:0:0.6">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Border
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    BorderThickness="3"
                    CornerRadius="8">
                    <Border.Effect>
                        <BlurEffect Radius="12" />
                    </Border.Effect>
                </Border>
                <Border
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="8" />
            </Grid>
            <!-- Rahmen, wenn ausgewählt: liegt genau auf dem Kachelrand, dazu ein weicher Schein -->
            <Grid IsHitTestVisible="False" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                <Border
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    BorderThickness="3"
                    CornerRadius="8"
                    Opacity="0.8">
                    <Border.Effect>
                        <BlurEffect Radius="10" />
                    </Border.Effect>
                </Border>
                <Border
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    BorderThickness="2"
                    CornerRadius="8" />
            </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo groß und dunkel mittig im Hintergrund, nur leicht zu erkennen -->
        <Image
            Grid.Row="0"
            Grid.RowSpan="4"
            Margin="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Opacity="0.35"
            RenderOptions.BitmapScalingMode="HighQuality"
            Source="pack://application:,,,/Assets/clippy-silhouette.png"
            Stretch="Uniform" />

        <!-- Kopfzeile -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Click="Refresh_Click"
                    Content="Aktualisieren"
                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
                <ui:Button
                    Appearance="Primary"
                    Click="AddFolder_Click"
                    Content="Ordner hinzufügen"
                    Icon="{ui:SymbolIcon FolderAdd24}" />
            </StackPanel>
            <StackPanel>
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="Bibliothek" />
                <TextBlock
                    x:Name="SummaryText"
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DockPanel>

        <!-- Filter -->
        <WrapPanel
            x:Name="FilterBar"
            Grid.Row="1"
            Margin="0,0,0,8">
            <ui:TextBox
                x:Name="SearchBox"
                Width="240"
                Margin="0,0,8,8"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="Suchen …"
                TextChanged="SearchBox_TextChanged" />
            <ComboBox
                x:Name="ShowCombo"
                Width="200"
                Margin="0,0,8,8"
                SelectionChanged="ShowCombo_Changed" />
            <ui:Button
                x:Name="CategoryMenuButton"
                Margin="0,0,8,8"
                Padding="8"
                VerticalAlignment="Stretch"
                Click="CategoryMenu_Click"
                Icon="{ui:SymbolIcon MoreHorizontal24}"
                ToolTip="Kategorie umbenennen oder löschen"
                Visibility="Collapsed" />
            <ComboBox
                x:Name="FolderCombo"
                Width="240"
                Margin="0,0,8,8"
                SelectionChanged="Filter_Changed" />
            <ComboBox
                x:Name="SortCombo"
                Width="190"
                Margin="0,0,8,8"
                SelectedIndex="0"
                SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Neueste zuerst" />
                <ComboBoxItem Content="Älteste zuerst" />
                <ComboBoxItem Content="Längste zuerst" />
                <ComboBoxItem Content="Größte zuerst" />
                <ComboBoxItem Content="Name A–Z" />
                <ComboBoxItem Content="Geschnittene zuerst" />
            </ComboBox>
        </WrapPanel>

        <!-- Auswahlleiste: ersetzt die Filter, solange Clips ausgewählt werden -->
        <Border
            x:Name="SelectionBar"
            Grid.Row="1"
            Margin="0,0,0,16"
            Padding="12,8"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <DockPanel>
                <ui:Button
                    Appearance="Primary"
                    Click="SelectionDone_Click"
                    Content="Fertig"
                    DockPanel.Dock="Right"
                    Icon="{ui:SymbolIcon Checkmark24}"
                    ToolTip="Auswahl beenden (Esc)" />
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock
                        x:Name="SelectionText"
                        Margin="0,0,16,0"
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:Button
                        x:Name="AddToCategoryButton"
                        Margin="0,0,8,0"
                        Click="AddToCategory_Click"
                        Content="Zu Kategorie hinzufügen"
                        Icon="{ui:SymbolIcon TagMultiple24}" />
                    <ui:Button
                        x:Name="RemoveFromCategoryButton"
                        Margin="0,0,8,0"
                        Click="RemoveFromCategory_Click"
                        Content="Aus Kategorie entfernen"
                        Icon="{ui:SymbolIcon TagDismiss24}"
                        Visibility="Collapsed" />
                    <ui:Button
                        x:Name="DeleteSelectedButton"
                        Margin="0,0,8,0"
                        Appearance="Danger"
                        Click="DeleteSelected_Click"
                        Content="Löschen"
                        Icon="{ui:SymbolIcon Delete24}"
                        ToolTip="Ausgewählte Clips in den Papierkorb verschieben" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Click="SelectPage_Click"
                        Content="Ganze Seite"
                        Icon="{ui:SymbolIcon SelectAllOn24}"
                        ToolTip="Alle Clips auf dieser Seite auswählen" />
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Transparent"
                        Click="SelectNone_Click"
                        Content="Nichts"
                        Icon="{ui:SymbolIcon SelectAllOff24}"
                        ToolTip="Auswahl leeren" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="Tipp: gedrückt halten und über Clips ziehen" />
                </WrapPanel>
            </DockPanel>
        </Border>

        <!-- Leerer Zustand -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <ui:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="56"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Symbol="VideoClip24" />
            <TextBlock
                x:Name="EmptyTitle"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Noch keine Clip-Ordner" />
            <TextBlock
                x:Name="EmptyHint"
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Füge den Ordner hinzu, in den OBS deine Clips speichert." />
        </StackPanel>

        <!-- Kacheln -->
        <ScrollViewer
            x:Name="TileScroller"
            Grid.Row="2"
            Focusable="False"
            FocusVisualStyle="{x:Null}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed">
            <ItemsControl x:Name="TileList" ItemTemplate="{StaticResource TileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Seiten -->
        <StackPanel
            x:Name="Pager"
            Grid.Row="3"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Visibility="Collapsed">
            <ui:Button
                x:Name="PrevButton"
                Click="PrevPage_Click"
                Content="Zurück"
                Icon="{ui:SymbolIcon ChevronLeft24}" />
            <TextBlock
                Margin="16,0,8,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Seite" />
            <TextBox
                x:Name="PageBox"
                Width="64"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                GotKeyboardFocus="PageBox_GotFocus"
                KeyDown="PageBox_KeyDown"
                LostKeyboardFocus="PageBox_LostFocus"
                ToolTip="Seitenzahl eingeben und Enter drücken" />
            <TextBlock
                x:Name="PageText"
                Margin="8,0,16,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:Button
                x:Name="NextButton"
                Click="NextPage_Click"
                Content="Weiter"
                Icon="{ui:SymbolIcon ChevronRight24}" />
        </StackPanel>
    </Grid>
</UserControl>
