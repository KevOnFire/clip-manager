<UserControl
    x:Class="ClipManager.Views.LibraryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ClipManager.Views"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:FavoriteBrushConverter x:Key="FavoriteBrush" />

        <ContextMenu x:Key="TileMenu" x:Shared="False">
            <MenuItem Click="MenuPlay_Click" Header="Abspielen">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Play24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuDisplayName_Click" Header="Namen im Programm ändern">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Tag24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuRename_Click" Header="Datei umbenennen">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Rename24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuCopy_Click" Header="Kopie erstellen">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Copy24" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Click="MenuExplorer_Click" Header="Im Explorer zeigen">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="FolderOpen24" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Click="MenuDelete_Click" Header="Löschen (Papierkorb)">
                <MenuItem.Icon>
                    <ui:SymbolIcon Symbol="Delete24" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <DataTemplate x:Key="TileTemplate" DataType="{x:Type local:ClipTileViewModel}">
            <Border
                Width="296"
                Margin="0,0,16,16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ContextMenu="{StaticResource TileMenu}"
                CornerRadius="8"
                Cursor="Hand"
                MouseLeftButtonUp="Tile_Click">
                <StackPanel>
                    <Grid
                        Height="165"
                        ClipToBounds="True"
                        MouseEnter="Thumb_MouseEnter"
                        MouseLeave="Thumb_MouseLeave">
                        <Border Background="#FF0E0E12" CornerRadius="7,7,0,0">
                            <ui:SymbolIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="36"
                                Foreground="#55FFFFFF"
                                Symbol="VideoClip24" />
                        </Border>
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />

                        <!-- Dauer oben rechts -->
                        <Border
                            Margin="8"
                            Padding="8,2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="#CC000000"
                            CornerRadius="10"
                            Visibility="{Binding HasDuration, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding DurationText}" />
                        </Border>

                        <!-- Schere oben links, wenn Schnitte gespeichert sind -->
                        <Border
                            Margin="8"
                            Padding="7,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#CC000000"
                            CornerRadius="10"
                            ToolTip="Geschnitten (Original unverändert)"
                            Visibility="{Binding IsEdited, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon
                                FontSize="14"
                                Foreground="#FFFFC83D"
                                Symbol="Cut24" />
                        </Border>

                        <!-- Favorit unten rechts -->
                        <Button
                            Width="34"
                            Height="34"
                            Margin="8"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#99000000"
                            BorderThickness="0"
                            Click="Star_Click"
                            Cursor="Hand"
                            ToolTip="Favorit">
                            <ui:SymbolIcon
                                FontSize="18"
                                Filled="{Binding IsFavorite}"
                                Foreground="{Binding IsFavorite, Converter={StaticResource FavoriteBrush}}"
                                Symbol="Star24" />
                        </Button>
                    </Grid>

                    <Grid Margin="12,10,4,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding ToolTipText}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding DateText}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding Details}" />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="1"
                            Padding="6"
                            VerticalAlignment="Top"
                            Appearance="Transparent"
                            BorderThickness="0"
                            Click="MoreButton_Click"
                            Icon="{ui:SymbolIcon MoreVertical24}"
                            ToolTip="Mehr" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Logo groß und dunkel mittig im Hintergrund, nur leicht zu erkennen -->
        <Image
            Grid.Row="0"
            Grid.RowSpan="4"
            Margin="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="False"
            Opacity="0.35"
            RenderOptions.BitmapScalingMode="HighQuality"
            Source="pack://application:,,,/Assets/clippy-silhouette.png"
            Stretch="Uniform" />

        <!-- Kopfzeile -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <ui:Button
                    Margin="0,0,8,0"
                    Click="Refresh_Click"
                    Content="Aktualisieren"
                    Icon="{ui:SymbolIcon ArrowClockwise24}" />
                <ui:Button
                    Appearance="Primary"
                    Click="AddFolder_Click"
                    Content="Ordner hinzufügen"
                    Icon="{ui:SymbolIcon FolderAdd24}" />
            </StackPanel>
            <StackPanel>
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="Bibliothek" />
                <TextBlock
                    x:Name="SummaryText"
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DockPanel>

        <!-- Filter -->
        <WrapPanel
            x:Name="FilterBar"
            Grid.Row="1"
            Margin="0,0,0,8">
            <ui:TextBox
                x:Name="SearchBox"
                Width="240"
                Margin="0,0,8,8"
                Icon="{ui:SymbolIcon Search24}"
                PlaceholderText="Suchen …"
                TextChanged="SearchBox_TextChanged" />
            <ComboBox
                x:Name="ShowCombo"
                Width="160"
                Margin="0,0,8,8"
                SelectedIndex="0"
                SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Alle Clips" />
                <ComboBoxItem Content="★ Favoriten" />
                <ComboBoxItem Content="✂ Geschnitten" />
                <ComboBoxItem Content="Ungeschnitten" />
            </ComboBox>
            <ComboBox
                x:Name="FolderCombo"
                Width="240"
                Margin="0,0,8,8"
                SelectionChanged="Filter_Changed" />
            <ComboBox
                x:Name="SortCombo"
                Width="190"
                Margin="0,0,8,8"
                SelectedIndex="0"
                SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="Neueste zuerst" />
                <ComboBoxItem Content="Älteste zuerst" />
                <ComboBoxItem Content="Längste zuerst" />
                <ComboBoxItem Content="Größte zuerst" />
                <ComboBoxItem Content="Name A–Z" />
                <ComboBoxItem Content="Geschnittene zuerst" />
            </ComboBox>
        </WrapPanel>

        <!-- Leerer Zustand -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <ui:SymbolIcon
                HorizontalAlignment="Center"
                FontSize="56"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Symbol="VideoClip24" />
            <TextBlock
                x:Name="EmptyTitle"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Noch keine Clip-Ordner" />
            <TextBlock
                x:Name="EmptyHint"
                Margin="0,6,0,0"
                HorizontalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Füge den Ordner hinzu, in den OBS deine Clips speichert." />
        </StackPanel>

        <!-- Kacheln -->
        <ScrollViewer
            x:Name="TileScroller"
            Grid.Row="2"
            Focusable="False"
            FocusVisualStyle="{x:Null}"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="Collapsed">
            <ItemsControl x:Name="TileList" ItemTemplate="{StaticResource TileTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- Seiten -->
        <StackPanel
            x:Name="Pager"
            Grid.Row="3"
            Margin="0,8,0,0"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Visibility="Collapsed">
            <ui:Button
                x:Name="PrevButton"
                Click="PrevPage_Click"
                Content="Zurück"
                Icon="{ui:SymbolIcon ChevronLeft24}" />
            <TextBlock
                x:Name="PageText"
                Margin="16,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ui:Button
                x:Name="NextButton"
                Click="NextPage_Click"
                Content="Weiter"
                Icon="{ui:SymbolIcon ChevronRight24}" />
        </StackPanel>
    </Grid>
</UserControl>
