<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ClipManager</RootNamespace>
    <AssemblyName>ClipManager</AssemblyName>
    <Product>Clippy</Product>
    <!-- Die exe heißt weiter ClipManager.exe, damit ältere Versionen sich noch per Update-Knopf aktualisieren können. -->
    <ApplicationIcon>Assets\clippy.ico</ApplicationIcon>
    <!-- Die echte Versionsnummer setzt der GitHub-Build (0.<Laufnummer>.0). -->
    <Version>0.0.0</Version>
    <!-- Erlaubt das Bauen auf Nicht-Windows-Rechnern (z.B. in der Cloud); laufen tut es nur unter Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\clippy.png" />
    <Resource Include="Assets\clippy.ico" />
    <Resource Include="Assets\clippy-silhouette.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ClipManager.Core\ClipManager.Core.csproj" />
  </ItemGroup>
</Project>
