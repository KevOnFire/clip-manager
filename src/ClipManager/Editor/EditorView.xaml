<UserControl
    x:Class="ClipManager.Editor.EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editor="clr-namespace:ClipManager.Editor"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <!-- Runde Knöpfe für die Zeichen-Werkzeuge unten links im Video -->
        <Style x:Key="RoundToolButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolIcon" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile: zurück zur Bibliothek + Name des Clips -->
        <DockPanel x:Name="HeaderBar" Grid.Row="0" Margin="16,0,16,8">
            <ui:Button
                Margin="0,0,12,0"
                Click="Back_Click"
                Content="Bibliothek"
                DockPanel.Dock="Left"
                Focusable="False"
                Icon="{ui:SymbolIcon ArrowLeft24}"
                ToolTip="Zurück zur Bibliothek (Schnitte sind schon gemerkt)" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ui:Button
                    x:Name="DeleteClipButton"
                    Margin="0,0,12,0"
                    Click="DeleteClip_Click"
                    Content="Löschen"
                    Focusable="False"
                    Icon="{ui:SymbolIcon Delete24}"
                    ToolTip="Diesen Clip in den Papierkorb verschieben" />
                <ui:Button
                    x:Name="FavoriteButton"
                    Margin="0,0,12,0"
                    Click="Favorite_Click"
                    Focusable="False"
                    ToolTip="Favorit (Stern)">
                    <ui:SymbolIcon x:Name="FavoriteIcon" Symbol="Star24" />
                </ui:Button>
                <ui:Button
                    x:Name="PrevClipButton"
                    Margin="0,0,6,0"
                    Click="PrevClip_Click"
                    Focusable="False"
                    Icon="{ui:SymbolIcon ChevronLeft24}"
                    ToolTip="Vorheriger Clip (Strg+←)" />
                <ui:Button
                    x:Name="NextClipButton"
                    Click="NextClip_Click"
                    Focusable="False"
                    Icon="{ui:SymbolIcon ChevronRight24}"
                    ToolTip="Nächster Clip (Strg+→)" />
            </StackPanel>
            <TextBlock
                x:Name="ClipTitle"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Video -->
        <Border
            x:Name="VideoBorder"
            Grid.Row="1"
            Margin="16,4,16,8"
            Background="Black"
            CornerRadius="8"
            MouseLeftButtonDown="Video_MouseLeftButtonDown">
            <Grid x:Name="VideoArea" ClipToBounds="True" SizeChanged="VideoArea_SizeChanged">
                <!-- Genau so groß wie das Bild (ohne schwarze Ränder), damit Objekte an der richtigen Stelle liegen -->
                <Grid
                    x:Name="VideoFrame"
                    LostMouseCapture="VideoFrame_LostMouseCapture"
                    MouseLeftButtonUp="VideoFrame_MouseLeftButtonUp"
                    MouseMove="VideoFrame_MouseMove"
                    PreviewMouseLeftButtonDown="VideoFrame_PreviewMouseLeftButtonDown">
                    <MediaElement
                        x:Name="Player"
                        LoadedBehavior="Manual"
                        MediaEnded="Player_MediaEnded"
                        MediaFailed="Player_MediaFailed"
                        MediaOpened="Player_MediaOpened"
                        ScrubbingEnabled="True"
                        Stretch="Uniform"
                        UnloadedBehavior="Close" />
                    <!-- Objekte (Boxen, Text, Unschärfe …) -->
                    <Canvas x:Name="OverlayCanvas" ClipToBounds="True" />
                    <!-- Rahmen mit Griffen um das ausgewählte Objekt -->
                    <Canvas x:Name="OverlayEditCanvas" />
                    <!-- Strich, der gerade mit dem Stift gemalt wird -->
                    <Canvas x:Name="PenCanvas" IsHitTestVisible="False" />
                </Grid>
                <TextBlock
                    x:Name="LoadingText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="#AAFFFFFF"
                    Text="Lädt …" />

                <!-- Eigenschaften des ausgewählten Objekts -->
                <Border
                    x:Name="OverlayPropsBar"
                    Margin="12"
                    Padding="10,6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#F01D1A22"
                    BorderBrush="#40FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    MouseLeftButtonDown="Swallow_MouseDown"
                    Visibility="Collapsed">
                    <WrapPanel x:Name="OverlayPropsPanel" MaxWidth="900" VerticalAlignment="Center" />
                </Border>

                <!-- Hinweis (z.B. beim Malen) -->
                <Border
                    x:Name="OverlayHintBar"
                    Margin="12"
                    Padding="12,6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Background="#F01D1A22"
                    CornerRadius="8"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <TextBlock x:Name="OverlayHintText" Foreground="White" />
                </Border>

                <!-- Stift-Knopf unten links: öffnet schmal nach oben die Werkzeuge -->
                <StackPanel
                    x:Name="OverlayTools"
                    Width="40"
                    Margin="12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    MouseLeftButtonDown="Swallow_MouseDown">
                    <Border
                        x:Name="OverlayToolStack"
                        Margin="0,0,0,6"
                        Padding="0,4"
                        Background="#F01D1A22"
                        BorderBrush="#40FFFFFF"
                        BorderThickness="1"
                        CornerRadius="20"
                        RenderTransformOrigin="0.5,1"
                        Visibility="Collapsed">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="OverlayToolScale" ScaleY="0" />
                        </Border.RenderTransform>
                        <StackPanel HorizontalAlignment="Center">
                            <Button Click="AddBox_Click" Style="{StaticResource RoundToolButton}" ToolTip="Box">
                                <Path Data="M4,5 H20 V19 H4 Z" Style="{StaticResource ToolIcon}" />
                            </Button>
                            <Button Click="AddCircle_Click" Style="{StaticResource RoundToolButton}" ToolTip="Kreis">
                                <Path Data="M12,4 A8,8 0 1 1 11.99,4 Z" Style="{StaticResource ToolIcon}" />
                            </Button>
                            <Button Click="AddBlur_Click" Style="{StaticResource RoundToolButton}" ToolTip="Unschärfe (zum Zensieren)">
                                <Path Data="M3,3 H8 V8 H3 Z M10,3 H15 V8 H10 Z M17,3 H21 V8 H17 Z M3,10 H8 V15 H3 Z M10,10 H15 V15 H10 Z M17,10 H21 V15 H17 Z M3,17 H8 V21 H3 Z M10,17 H15 V21 H10 Z M17,17 H21 V21 H17 Z" Fill="#B0FFFFFF" Stroke="{x:Null}" Style="{StaticResource ToolIcon}" />
                            </Button>
                            <Button Click="AddText_Click" Style="{StaticResource RoundToolButton}" ToolTip="Text">
                                <Path Data="M5,5 H19 M12,5 V20" Style="{StaticResource ToolIcon}" />
                            </Button>
                            <Button Click="AddPen_Click" Style="{StaticResource RoundToolButton}" ToolTip="Stift (malen)">
                                <Path Data="M3,17 C6,11 9,19 12,14 S17,8 21,10" Style="{StaticResource ToolIcon}" />
                            </Button>
                            <Button Click="AddImage_Click" Style="{StaticResource RoundToolButton}" ToolTip="Bild (PNG, JPG …)">
                                <Path Data="M4,5 H20 V19 H4 Z M4,16 L9,11 L13,15 L16,12 L20,16 M15,8.5 A1,1 0 1 1 14.99,8.5" Style="{StaticResource ToolIcon}" />
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button
                        x:Name="PencilButton"
                        Width="40"
                        Height="40"
                        Margin="0"
                        Background="#C0141218"
                        Click="Pencil_Click"
                        Style="{StaticResource RoundToolButton}"
                        ToolTip="Zeichnen: Box, Kreis, Unschärfe, Text, Stift, Bild">
                        <Path
                            Width="20"
                            Height="20"
                            Data="M12,20 H21 M16.5,3.5 A2.1,2.1 0 0 1 19.5,6.5 L7,19 L3,20 L4,16 Z"
                            Style="{StaticResource ToolIcon}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Abspielleiste -->
        <DockPanel x:Name="TransportBar" Grid.Row="2" Margin="16,0,16,8" LastChildFill="False">
            <!-- Nur im Vollbild: Leiste zum Spulen (sonst ist die Zeitleiste dafür da) -->
            <Slider
                x:Name="SeekSlider"
                Margin="0,0,0,6"
                Cursor="Hand"
                DockPanel.Dock="Top"
                Focusable="False"
                Maximum="1"
                Minimum="0"
                PreviewMouseLeftButtonDown="SeekSlider_MouseDown"
                PreviewMouseLeftButtonUp="SeekSlider_MouseUp"
                PreviewMouseMove="SeekSlider_MouseMove"
                Visibility="Collapsed" />
            <ui:Button
                x:Name="PlayButton"
                Width="44"
                Height="36"
                Padding="0"
                Click="PlayButton_Click"
                DockPanel.Dock="Left"
                Focusable="False"
                Icon="{ui:SymbolIcon Play24, Filled=True}"
                ToolTip="Abspielen / Pause (Leertaste)" />
            <TextBlock
                x:Name="PositionText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                FontFamily="Consolas"
                FontSize="15"
                Text="0:00.0 / 0:00.0" />
            <TextBlock
                x:Name="ResultText"
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ui:Button
                x:Name="FullscreenButton"
                Width="40"
                Height="36"
                Margin="12,0,0,0"
                Padding="0"
                Click="Fullscreen_Click"
                DockPanel.Dock="Right"
                Focusable="False"
                Icon="{ui:SymbolIcon FullScreenMaximize24}"
                ToolTip="Vollbild (F, Doppelklick aufs Video, Esc zum Beenden)" />
            <Slider
                IsMoveToPointEnabled="True"
                x:Name="VolumeSlider"
                Width="120"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Focusable="False"
                Maximum="1"
                Minimum="0"
                ToolTip="Lautstärke der Vorschau"
                ValueChanged="VolumeSlider_ValueChanged"
                Value="0.8" />
            <ui:SymbolIcon
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Symbol="Speaker224" />
            <CheckBox
                x:Name="PreviewCutsCheck"
                Margin="0,0,20,0"
                VerticalAlignment="Center"
                Content="Schnitte in der Vorschau überspringen"
                DockPanel.Dock="Right"
                Focusable="False"
                IsChecked="True" />
        </DockPanel>

        <!-- Zeitleiste, darunter eine Zeile pro Tonspur (links die Spur-Köpfe) -->
        <!-- Spuren lassen sich einklappen: dann bleibt nur der Filmstreifen, rechts kleine An/Aus-Knöpfe pro Spur -->
        <Grid x:Name="TracksArea" Grid.Row="3" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="TrackHeaderPanel"
                Grid.Column="0"
                Width="258"
                ClipToBounds="True">
                <DockPanel Width="250" Height="92" HorizontalAlignment="Left">
                    <DockPanel Margin="0,0,0,6" DockPanel.Dock="Bottom">
                        <ui:Button
                            Padding="8,3"
                            Click="CollapseTracks_Click"
                            Content="Einklappen"
                            DockPanel.Dock="Left"
                            FontSize="12"
                            Focusable="False"
                            Icon="{ui:SymbolIcon ChevronDoubleRight20}"
                            ToolTip="Spuren einklappen, damit das Video mehr Platz hat" />
                        <!-- Umschalter: unter dem Filmstreifen Tonspuren oder Objekte zeigen -->
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button
                                x:Name="AudioModeButton"
                                Padding="10,3"
                                Appearance="Primary"
                                Click="AudioMode_Click"
                                Content="Ton"
                                FontSize="12"
                                Focusable="False"
                                ToolTip="Tonspuren zeigen" />
                            <ui:Button
                                x:Name="ObjectsModeButton"
                                Margin="4,0,0,0"
                                Padding="10,3"
                                Appearance="Secondary"
                                Click="ObjectsMode_Click"
                                Content="Objekte"
                                FontSize="12"
                                Focusable="False"
                                ToolTip="Objekte (Boxen, Text, Unschärfe …) zeigen, mit Ebenen" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock
                        x:Name="TracksHint"
                        Padding="0,6,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="Tonspuren werden geladen …"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </DockPanel>
                <!-- Ebenen-Liste: oben = ganz vorne, Einträge ziehen zum Umsortieren -->
                <ScrollViewer
                    x:Name="LayerArea"
                    Width="250"
                    HorizontalAlignment="Left"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel x:Name="LayerList" />
                </ScrollViewer>
                <ItemsControl x:Name="TrackHeaders" Width="250" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type editor:TrackRowViewModel}">
                            <Border
                                Height="30"
                                Margin="0,0,0,4"
                                Padding="6,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="4">
                                <DockPanel VerticalAlignment="Center">
                                    <Border
                                        Width="4"
                                        Height="20"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding ColorBrush}"
                                        CornerRadius="2"
                                        DockPanel.Dock="Left" />
                                    <CheckBox
                                        MinWidth="0"
                                        Margin="0,0,4,0"
                                        Padding="4,0,0,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        Focusable="False"
                                        IsChecked="{Binding Enabled}"
                                        ToolTip="Spur an/aus" />
                                    <TextBlock
                                        Width="36"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding VolumeText}"
                                        TextAlignment="Right" />
                                    <Slider
                IsMoveToPointEnabled="True"
                                        Width="70"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Focusable="False"
                                        Maximum="2"
                                        Minimum="0"
                                        PreviewMouseLeftButtonDown="TrackVolume_MouseDown"
                                        ToolTip="Lautstärke dieser Spur"
                                        Value="{Binding Volume}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        MouseLeftButtonDown="TrackName_MouseLeftButtonDown"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="Doppelklick zum Umbenennen" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border
                x:Name="TimelineHost"
                Grid.Column="1"
                VerticalAlignment="Top"
                CornerRadius="6"
                ClipToBounds="True">
                <editor:TimelineControl x:Name="TimelineView" VerticalAlignment="Top" />
            </Border>

            <!-- Eingeklappt: rechts pro Spur ein kleiner An/Aus-Knopf -->
            <Grid
                x:Name="CompactTracks"
                Grid.Column="2"
                Width="0"
                Height="88"
                VerticalAlignment="Top"
                ClipToBounds="True"
                Opacity="0">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="CompactTracksShift" X="40" />
                </Grid.RenderTransform>
                <DockPanel Width="262" Margin="8,0,0,0" HorizontalAlignment="Left">
                    <ui:Button
                        Width="30"
                        Margin="0,0,6,0"
                        Padding="0"
                        VerticalAlignment="Stretch"
                        Click="ExpandTracks_Click"
                        DockPanel.Dock="Left"
                        Focusable="False"
                        Icon="{ui:SymbolIcon ChevronDoubleLeft20}"
                        ToolTip="Tonspuren wieder ausklappen" />
                    <ItemsControl x:Name="CompactTrackList" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type editor:TrackRowViewModel}">
                                <ToggleButton
                                    Width="108"
                                    Height="26"
                                    Margin="0,0,4,4"
                                    Padding="6,0"
                                    HorizontalContentAlignment="Left"
                                    Focusable="False"
                                    IsChecked="{Binding Enabled}"
                                    ToolTip="{Binding Name}">
                                    <DockPanel>
                                        <Border
                                            Width="4"
                                            Height="14"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding ColorBrush}"
                                            CornerRadius="2"
                                            DockPanel.Dock="Left" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Werkzeuge -->
        <DockPanel Grid.Row="4" Margin="16,0,16,8">
        <StackPanel
            x:Name="BottomBar"
            Margin="16,0,0,8"
            VerticalAlignment="Top"
            DockPanel.Dock="Right"
            Orientation="Horizontal">
            <ui:Button
                x:Name="ExportButton"
                Appearance="Primary"
                Click="Export_Click"
                Focusable="False"
                Content="Exportieren"
                Icon="{ui:SymbolIcon ArrowExportUp24}"
                ToolTip="Clip passend fürs Discord-Limit exportieren" />
            <ui:Button
                x:Name="SaveButton"
                Margin="8,0,0,0"
                Click="Save_Click"
                Content="Speichern unter …"
                Focusable="False"
                Icon="{ui:SymbolIcon SaveCopy24}"
                ToolTip="Öffnet den Speichern-Dialog: in voller Qualität als Kopie, an einen anderen Ort oder Original ersetzen" />
            <ui:Button
                x:Name="QuickSaveButton"
                Margin="8,0,0,0"
                Click="QuickSave_Click"
                Content="Original überschreiben"
                Focusable="False"
                Icon="{ui:SymbolIcon Save24}"
                ToolTip="Schnellspeichern ohne Nachfrage: das Original wird durch den geschnittenen Clip ersetzt (volle Qualität, altes Original landet im Papierkorb)" />
        </StackPanel>
        <WrapPanel x:Name="ToolsBar">
            <WrapPanel.Resources>
                <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                    <Setter Property="Margin" Value="0,0,8,8" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </WrapPanel.Resources>
            <ui:Button
                Click="SetIn_Click"
                Content="Anfang hier  (I)"
                Icon="{ui:SymbolIcon ArrowStepIn24}"
                ToolTip="Alles vor dem Abspielkopf fällt weg" />
            <ui:Button
                Click="SetOut_Click"
                Content="Ende hier  (O)"
                Icon="{ui:SymbolIcon ArrowStepOut24}"
                ToolTip="Alles nach dem Abspielkopf fällt weg" />
            <ui:Button
                Click="Split_Click"
                Content="Schneiden  (S)"
                Icon="{ui:SymbolIcon Cut24}"
                ToolTip="Setzt einen Schnitt am Abspielkopf. Danach kann ein Teil entfernt werden." />
            <ui:Button
                x:Name="RemoveButton"
                Click="Remove_Click"
                Content="Teil entfernen  (Entf)"
                Icon="{ui:SymbolIcon Delete24}"
                ToolTip="Entfernt den Teil unter dem Abspielkopf oder holt ihn zurück" />
            <ui:Button
                x:Name="UndoButton"
                Click="Undo_Click"
                Content="Rückgängig  (Strg+Z)"
                Icon="{ui:SymbolIcon ArrowUndo24}" />
            <ui:Button
                Click="Reset_Click"
                Content="Alles zurücksetzen"
                Icon="{ui:SymbolIcon ArrowReset24}" />
        </WrapPanel>
        </DockPanel>


    </Grid>
</UserControl>
