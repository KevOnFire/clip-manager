<UserControl
    x:Class="ClipManager.Editor.EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editor="clr-namespace:ClipManager.Editor"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopfzeile: zurück zur Bibliothek + Name des Clips -->
        <DockPanel x:Name="HeaderBar" Grid.Row="0" Margin="16,0,16,8">
            <ui:Button
                Margin="0,0,12,0"
                Click="Back_Click"
                Content="Bibliothek"
                DockPanel.Dock="Left"
                Focusable="False"
                Icon="{ui:SymbolIcon ArrowLeft24}"
                ToolTip="Zurück zur Bibliothek (Schnitte sind schon gemerkt)" />
            <TextBlock
                x:Name="ClipTitle"
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="SemiBold"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- Video -->
        <Border
            x:Name="VideoBorder"
            Grid.Row="1"
            Margin="16,4,16,8"
            Background="Black"
            CornerRadius="8"
            MouseLeftButtonDown="Video_MouseLeftButtonDown">
            <Grid>
                <MediaElement
                    x:Name="Player"
                    LoadedBehavior="Manual"
                    MediaEnded="Player_MediaEnded"
                    MediaFailed="Player_MediaFailed"
                    MediaOpened="Player_MediaOpened"
                    ScrubbingEnabled="True"
                    Stretch="Uniform"
                    UnloadedBehavior="Close" />
                <TextBlock
                    x:Name="LoadingText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="#AAFFFFFF"
                    Text="Lädt …" />
            </Grid>
        </Border>

        <!-- Abspielleiste -->
        <DockPanel x:Name="TransportBar" Grid.Row="2" Margin="16,0,16,8" LastChildFill="False">
            <!-- Nur im Vollbild: Leiste zum Spulen (sonst ist die Zeitleiste dafür da) -->
            <Slider
                x:Name="SeekSlider"
                Margin="0,0,0,6"
                DockPanel.Dock="Top"
                Focusable="False"
                IsMoveToPointEnabled="True"
                Maximum="1"
                Minimum="0"
                Thumb.DragCompleted="SeekSlider_DragCompleted"
                Thumb.DragStarted="SeekSlider_DragStarted"
                ValueChanged="SeekSlider_ValueChanged"
                Visibility="Collapsed" />
            <ui:Button
                x:Name="PlayButton"
                Width="44"
                Height="36"
                Padding="0"
                Click="PlayButton_Click"
                DockPanel.Dock="Left"
                Focusable="False"
                Icon="{ui:SymbolIcon Play24, Filled=True}"
                ToolTip="Abspielen / Pause (Leertaste)" />
            <TextBlock
                x:Name="PositionText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                FontFamily="Consolas"
                FontSize="15"
                Text="0:00.0 / 0:00.0" />
            <TextBlock
                x:Name="ResultText"
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ui:Button
                x:Name="FullscreenButton"
                Width="40"
                Height="36"
                Margin="12,0,0,0"
                Padding="0"
                Click="Fullscreen_Click"
                DockPanel.Dock="Right"
                Focusable="False"
                Icon="{ui:SymbolIcon FullScreenMaximize24}"
                ToolTip="Vollbild (F, Doppelklick aufs Video, Esc zum Beenden)" />
            <Slider
                x:Name="VolumeSlider"
                Width="120"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Focusable="False"
                Maximum="1"
                Minimum="0"
                ToolTip="Lautstärke der Vorschau"
                ValueChanged="VolumeSlider_ValueChanged"
                Value="0.8" />
            <ui:SymbolIcon
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Symbol="Speaker224" />
            <CheckBox
                x:Name="PreviewCutsCheck"
                Margin="0,0,20,0"
                VerticalAlignment="Center"
                Content="Schnitte in der Vorschau überspringen"
                DockPanel.Dock="Right"
                Focusable="False"
                IsChecked="True" />
        </DockPanel>

        <!-- Zeitleiste, darunter eine Zeile pro Tonspur (links die Spur-Köpfe) -->
        <Grid x:Name="TracksArea" Grid.Row="3" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock
                    x:Name="TracksHint"
                    Height="92"
                    Padding="0,6,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="Tonspuren werden geladen …"
                    TextWrapping="Wrap" />
                <ItemsControl x:Name="TrackHeaders">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type editor:TrackRowViewModel}">
                            <Border
                                Height="30"
                                Margin="0,0,0,4"
                                Padding="6,0"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="4">
                                <DockPanel VerticalAlignment="Center">
                                    <Border
                                        Width="4"
                                        Height="20"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Background="{Binding ColorBrush}"
                                        CornerRadius="2"
                                        DockPanel.Dock="Left" />
                                    <CheckBox
                                        MinWidth="0"
                                        Margin="0,0,4,0"
                                        Padding="4,0,0,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        Focusable="False"
                                        IsChecked="{Binding Enabled}"
                                        ToolTip="Spur an/aus" />
                                    <TextBlock
                                        Width="36"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding VolumeText}"
                                        TextAlignment="Right" />
                                    <Slider
                                        Width="70"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right"
                                        Focusable="False"
                                        Maximum="2"
                                        Minimum="0"
                                        Thumb.DragStarted="TrackVolume_DragStarted"
                                        ToolTip="Lautstärke dieser Spur"
                                        Value="{Binding Volume}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        MouseLeftButtonDown="TrackName_MouseLeftButtonDown"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="Doppelklick zum Umbenennen" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border
                Grid.Column="1"
                VerticalAlignment="Top"
                CornerRadius="6"
                ClipToBounds="True">
                <editor:TimelineControl x:Name="TimelineView" />
            </Border>
        </Grid>

        <!-- Werkzeuge -->
        <WrapPanel x:Name="ToolsBar" Grid.Row="4" Margin="16,0,16,4">
            <WrapPanel.Resources>
                <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                    <Setter Property="Margin" Value="0,0,8,8" />
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </WrapPanel.Resources>
            <ui:Button
                Click="SetIn_Click"
                Content="Anfang hier  (I)"
                Icon="{ui:SymbolIcon ArrowStepIn24}"
                ToolTip="Alles vor dem Abspielkopf fällt weg" />
            <ui:Button
                Click="SetOut_Click"
                Content="Ende hier  (O)"
                Icon="{ui:SymbolIcon ArrowStepOut24}"
                ToolTip="Alles nach dem Abspielkopf fällt weg" />
            <ui:Button
                Click="Split_Click"
                Content="Schneiden  (S)"
                Icon="{ui:SymbolIcon Cut24}"
                ToolTip="Setzt einen Schnitt am Abspielkopf. Danach kann ein Teil entfernt werden." />
            <ui:Button
                x:Name="RemoveButton"
                Click="Remove_Click"
                Content="Teil entfernen  (Entf)"
                Icon="{ui:SymbolIcon Delete24}"
                ToolTip="Entfernt den Teil unter dem Abspielkopf oder holt ihn zurück" />
            <ui:Button
                x:Name="UndoButton"
                Click="Undo_Click"
                Content="Rückgängig  (Strg+Z)"
                Icon="{ui:SymbolIcon ArrowUndo24}" />
            <ui:Button
                Click="Reset_Click"
                Content="Alles zurücksetzen"
                Icon="{ui:SymbolIcon ArrowReset24}" />
        </WrapPanel>

        <DockPanel x:Name="BottomBar" Grid.Row="5" Margin="16,0,16,14">
            <ui:Button
                x:Name="SaveButton"
                Margin="8,0,0,0"
                Click="Save_Click"
                Content="Speichern"
                DockPanel.Dock="Right"
                Icon="{ui:SymbolIcon Save24}"
                ToolTip="Geschnittenen Clip in voller Qualität speichern: Original ersetzen, Kopie oder woanders hin" />
            <ui:Button
                x:Name="ExportButton"
                Appearance="Primary"
                Content="Exportieren"
                DockPanel.Dock="Right"
                Click="Export_Click"
                Icon="{ui:SymbolIcon ArrowExportUp24}"
                ToolTip="Clip passend fürs Discord-Limit exportieren" />
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="Leertaste: Abspielen · F: Vollbild · ← →: 1 s (mit Umschalt 5 s) · , .: einzelnes Bild · Pos1/Ende: zu Anfang/Ende · In einer Spur ziehen: Stelle stumm schalten oder rausschneiden · Ränder von stummen/rausgeschnittenen Stellen lassen sich ziehen · Schnitte werden automatisch gemerkt, das Original bleibt, bis du es beim Speichern ersetzt."
                TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</UserControl>
