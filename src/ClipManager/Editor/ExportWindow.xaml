<ui:FluentWindow
    x:Class="ClipManager.Editor.ExportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Icon="pack://application:,,,/Assets/clippy.ico"
    Title="Exportieren"
    Width="560"
    SizeToContent="Height"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">
    <StackPanel>
        <ui:TitleBar
            Title="Exportieren"
            ShowMaximize="False"
            ShowMinimize="False" />

        <StackPanel Margin="20,4,20,20">
            <!-- Einstellungen -->
            <StackPanel x:Name="SetupPanel">
                <TextBlock Margin="0,0,0,6" Text="Wofür?" />
                <ComboBox x:Name="TargetCombo" SelectionChanged="TargetCombo_SelectionChanged" />

                <Border
                    Margin="0,14,0,0"
                    Padding="14,10"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6">
                    <StackPanel>
                        <TextBlock x:Name="PlanText" TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="PlanDetailText"
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="WarningText"
                            Margin="0,6,0,0"
                            FontSize="12"
                            Foreground="#FFFFB454"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <ui:Button
                    x:Name="StartButton"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Stretch"
                    Appearance="Primary"
                    Click="Start_Click"
                    Content="Exportieren"
                    Icon="{ui:SymbolIcon ArrowExportUp24}"
                    IsEnabled="False" />
            </StackPanel>

            <!-- Fortschritt -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                <TextBlock x:Name="ProgressText" Text="Exportiere …" />
                <ProgressBar
                    x:Name="ProgressBarControl"
                    Height="6"
                    Margin="0,10,0,0"
                    Maximum="1" />
                <ui:Button
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Click="Cancel_Click"
                    Content="Abbrechen" />
            </StackPanel>

            <!-- Fertig -->
            <StackPanel x:Name="DonePanel" Visibility="Collapsed">
                <TextBlock
                    x:Name="DoneTitle"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Fertig!" />
                <TextBlock
                    x:Name="DoneText"
                    Margin="0,4,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />

                <!-- Zum Rausziehen -->
                <Border
                    x:Name="DragCard"
                    Margin="0,14,0,0"
                    Padding="14"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                    BorderThickness="1"
                    Cursor="Hand"
                    CornerRadius="8"
                    MouseLeftButtonDown="DragCard_MouseLeftButtonDown"
                    MouseMove="DragCard_MouseMove"
                    ToolTip="Anfassen und z.B. in Discord ziehen">
                    <DockPanel>
                        <ui:SymbolIcon
                            Margin="0,0,12,0"
                            FontSize="32"
                            Symbol="VideoClip24" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                x:Name="FileNameText"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Hier anfassen und in Discord reinziehen" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <WrapPanel Margin="0,14,0,0">
                    <ui:Button
                        Margin="0,0,8,8"
                        Click="CopyFile_Click"
                        Content="Kopieren (in Discord Strg+V)"
                        Icon="{ui:SymbolIcon Copy24}" />
                    <ui:Button
                        x:Name="ShowInExplorerButton"
                        Margin="0,0,8,8"
                        Click="ShowInExplorer_Click"
                        Content="Im Explorer zeigen"
                        Icon="{ui:SymbolIcon FolderOpen24}"
                        Visibility="Collapsed" />
                </WrapPanel>

                <TextBlock
                    Margin="0,8,0,6"
                    FontWeight="SemiBold"
                    Text="Speichern" />
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Zum Reinziehen oder Kopieren musst du nichts speichern. Die Datei liegt nur zwischengespeichert und wird nach 2 Tagen weggeräumt."
                    TextWrapping="Wrap" />
                <WrapPanel>
                    <ui:Button
                        Margin="0,0,8,8"
                        Click="Replace_Click"
                        Content="Original ersetzen"
                        Icon="{ui:SymbolIcon ArrowSwap24}"
                        ToolTip="Das Original kommt in den Papierkorb, der geschnittene Clip nimmt seinen Platz ein" />
                    <ui:Button
                        Margin="0,0,8,8"
                        Click="SaveCopy_Click"
                        Content="Als Kopie speichern"
                        Icon="{ui:SymbolIcon DocumentCopy24}"
                        ToolTip="Neue Datei neben dem Original, das Original bleibt" />
                    <ui:Button
                        Margin="0,0,8,8"
                        Click="SaveAs_Click"
                        Content="Speichern unter …"
                        Icon="{ui:SymbolIcon Save24}" />
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</ui:FluentWindow>
